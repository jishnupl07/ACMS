<mxfile host="app.diagrams.net" pages="2">
  <diagram name="Page-1" id="6VPtAzUIzrRgi2RnF2nH">
    <mxGraphModel dx="5160" dy="3853" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\n    %% =====================================================\n    %% PEOPLE\n    %% =====================================================\n\n    namespace People {\n\n        class Person {\n            &lt;&lt;abstract&gt;&gt;\n            -String id\n            -String name\n            -int age\n            -String contactNumber\n            -String email\n            +Person(String, String, int, String, String)\n            +getId() String\n            +getName() String\n            +setContactNumber(String) void\n            +getContactNumber() String\n            +displayInfo()* void\n        }\n\n        class Participant {\n            -String skillLevel\n            -EmergencyContact emergencyContact\n            -MedicalRecord medicalRecord\n            +register(Camp, Activity) Registration\n            +cancelRegistration(Registration) void\n            +viewSchedule(CampSchedule) void\n            +submitFeedback(Activity, String, int) Feedback\n            +displayInfo() void\n        }\n\n        class Instructor {\n            -String specialization\n            -List~String~ certifications\n            -boolean isAvailable\n            +assignActivity(Activity) void\n            +removeActivity(Activity) void\n            +conductActivity(Activity) void\n            +checkParticipants(Activity) void\n            +sendNotification(String) void\n            +displayInfo() void\n        }\n\n        class AdminStaff {\n            -String role\n            -String department\n            +manageCamp(Camp) void\n            +addParticipant(Camp, Participant) void\n            +assignInstructor(Camp, Instructor) void\n            +scheduleActivity(Camp, Activity, Date) void\n            +generateCampReport(Camp) String\n            +sendNotification(String) void\n            +displayInfo() void\n        }\n\n        class EmergencyContact {\n            -String contactName\n            -String relationship\n            -String phoneNumber\n            +updateContact(String, String, String) void\n            +getContactDetails() String\n        }\n\n        class MedicalRecord {\n            -String bloodGroup\n            -List~String~ allergies\n            -List~String~ medicalConditions\n            -List~String~ medications\n            +addMedicalCondition(String) void\n            +addAllergy(String) void\n            +updateMedication(String) void\n            +getMedicalSummary() String\n        }\n    }\n\n    %% INHERITANCE\n    Person &lt;|-- Participant\n    Person &lt;|-- Instructor\n    Person &lt;|-- AdminStaff\n\n\n    %% =====================================================\n    %% ACTIVITIES\n    %% =====================================================\n\n    namespace Activities {\n\n        class Activity {\n            &lt;&lt;abstract&gt;&gt;\n            -String activityId\n            -String title\n            -String description\n            -int durationMinutes\n            -int maxParticipants\n            -DateTime startTime\n            +checkAvailability() boolean\n            +conductActivity()* void\n            +getStartTime() DateTime\n            +getEndTime() DateTime\n            +updateSchedule(DateTime) void\n            +getDetails() String\n        }\n\n        class AdventureActivity {\n            -String terrainType\n            -String riskLevel\n            +conductActivity() void\n            +checkTerrainSafety() boolean\n        }\n\n        class WaterActivity {\n            -boolean lifeguardRequired\n            -String waterBodyType\n            +conductActivity() void\n            +checkWaterSafety() boolean\n        }\n\n        class TeamBuildingActivity {\n            -int teamSize\n            +conductActivity() void\n            +formTeams(List~Participant~) void\n        }\n\n        class Schedulable {\n            &lt;&lt;interface&gt;&gt;\n            +getStartTime() DateTime\n            +getEndTime() DateTime\n            +updateSchedule(DateTime) void\n        }\n\n        class Location {\n            -String locationId\n            -String name\n            -String address\n            -String terrainType\n            -int capacity\n            +checkAvailability(DateTime) boolean\n            +reserve(DateTime) void\n            +release(DateTime) void\n            +getLocationDetails() String\n        }\n\n        class Feedback {\n            -String feedbackId\n            -int rating\n            -String comments\n            -Date submittedDate\n            +submit() void\n            +updateComment(String) void\n            +getFeedback() String\n        }\n    }\n\n    %% INHERITANCE\n    Activity &lt;|-- AdventureActivity\n    Activity &lt;|-- WaterActivity\n    Activity &lt;|-- TeamBuildingActivity\n\n\n    %% =====================================================\n    %% EQUIPMENT\n    %% =====================================================\n\n    namespace EquipmentManagement {\n\n        class Equipment {\n            &lt;&lt;abstract&gt;&gt;\n            -String equipmentId\n            -String name\n            -boolean isAvailable\n            -String condition\n            +checkCondition()* String\n            +allocate() void\n            +release() void\n            +isAvailableFor(Activity) boolean\n        }\n\n        class SafetyEquipment {\n            -Date lastInspectionDate\n            -String safetyRating\n            +checkCondition() String\n            +performSafetyInspection() boolean\n            +getSafetyRating() String\n        }\n\n        class SportsEquipment {\n            -String sportType\n            -String condition\n            +checkCondition() String\n            +checkCompatibility(Activity) boolean\n        }\n    }\n\n    %% INHERITANCE\n    Equipment &lt;|-- SafetyEquipment\n    Equipment &lt;|-- SportsEquipment\n\n\n    %% =====================================================\n    %% MANAGEMENT\n    %% =====================================================\n\n    namespace Management {\n\n        class Camp {\n            -String campId\n            -String campName\n            -Date startDate\n            -Date endDate\n            -int capacity\n            -String status\n            -List~Participant~ participants\n            -List~Instructor~ instructors\n            -List~Activity~ activities\n            +addParticipant(Participant) void\n            +removeParticipant(Participant) void\n            +addInstructor(Instructor) void\n            +removeInstructor(Instructor) void\n            +addActivity(Activity) void\n            +removeActivity(Activity) void\n            +registerParticipant(Participant, Activity) Registration\n            +scheduleActivity(Activity, DateTime) void\n            +generateReport() String\n            +checkCapacity() boolean\n        }\n\n        class CampSchedule {\n            -List~ScheduleEntry~ entries\n            +addActivityToSchedule(Activity, Date) void\n            +removeActivity(Activity) void\n            +rescheduleActivity(Activity, DateTime) void\n            +getActivitiesForDate(Date) List~Activity~\n            +displaySchedule() String\n        }\n\n        class ScheduleEntry {\n            -Date date\n            -Activity activity\n            -String startTime\n            -String endTime\n            +getDate() Date\n            +getActivity() Activity\n            +updateTime(String, String) void\n        }\n\n        class Registration {\n            -String registrationId\n            -Date registrationDate\n            -String status\n            -Participant participant\n            -Activity activity\n            +processRegistration() void\n            +confirmRegistration() void\n            +cancelRegistration() void\n            +checkEligibility() boolean\n            +getRegistrationStatus() String\n        }\n\n        class Attendance {\n            -Date date\n            -List~AttendanceRecord~ records\n            +markAttendance(Participant, boolean) void\n            +markActivityAttendance(Activity, Participant, boolean) void\n            +getParticipantAttendance(Participant) boolean\n            +getAttendanceReport() String\n        }\n\n        class AttendanceRecord {\n            -Participant participant\n            -Activity activity\n            -Date date\n            -boolean present\n            +markPresent() void\n            +markAbsent() void\n            +getStatus() boolean\n        }\n\n        class SafetyCheck {\n            -String checkId\n            -Date checkDate\n            -boolean passed\n            -String remarks\n            +performCheck(Equipment) void\n            +checkActivitySafety(Activity) boolean\n            +recordResult(boolean, String) void\n            +isPassed() boolean\n        }\n\n        class EquipmentAllocation {\n            -String allocationId\n            -Date allocationDate\n            -Date returnDate\n            -String status\n            -Equipment equipment\n            -Activity activity\n            +allocateEquipment(Equipment, Activity) void\n            +returnEquipment() void\n            +checkAvailability() boolean\n            +getAllocationStatus() String\n        }\n\n        class Notifiable {\n            &lt;&lt;interface&gt;&gt;\n            +sendNotification(String) void\n        }\n    }\n\n\n    %% =====================================================\n    %% EXCEPTIONS\n    %% =====================================================\n\n    namespace Exceptions {\n\n        class CampException {\n            &lt;&lt;exception&gt;&gt;\n            #String message\n            +CampException(String)\n            +getMessage() String\n        }\n\n        class RegistrationException {\n            &lt;&lt;exception&gt;&gt;\n            +RegistrationException(String)\n        }\n\n        class EquipmentUnavailableException {\n            &lt;&lt;exception&gt;&gt;\n            +EquipmentUnavailableException(String)\n        }\n\n        class SafetyViolationException {\n            &lt;&lt;exception&gt;&gt;\n            +SafetyViolationException(String)\n        }\n\n        class CapacityExceededException {\n            &lt;&lt;exception&gt;&gt;\n            +CapacityExceededException(String)\n        }\n    }\n\n    %% INHERITANCE\n    CampException &lt;|-- RegistrationException\n    CampException &lt;|-- EquipmentUnavailableException\n    CampException &lt;|-- SafetyViolationException\n    CampException &lt;|-- CapacityExceededException&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hMX-E50p89maekYDbELZ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
