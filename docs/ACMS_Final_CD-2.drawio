<mxfile host="app.diagrams.net" pages="3">
  <diagram name="Page-1" id="TUGa8KKBybqcJJBlQQwj">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n  elk:\n    mergeEdges: true\n    nodePlacementStrategy: NETWORK_SIMPLEX\n---\nclassDiagram\ndirection TB\n\nclassDiagram\n\nnamespace people {\n    class Person {\n        &lt;&lt;abstract&gt;&gt;\n        -String id\n        -String name\n        -int age\n        -String contactNumber\n        +getId()\n        +getName()\n        +getAge()\n        +getContactNumber()\n        +setContactNumber()\n        +displayInfo()*\n    }\n\n    class Participant {\n        -String emergencyContact\n        -String medicalNotes\n        -String skillLevel\n        -List~Registration~ registrations\n        +getRegistrations()\n        +addRegistration()\n        +removeRegistration()\n        +isRegisteredFor()\n        +getRegisteredActivities()\n        +displayInfo()\n    }\n\n    class Instructor {\n        -String specialization\n        -List~String~ certifications\n        -boolean isAvailable\n        -List~Activity~ assignedActivities\n        +getSpecialization()\n        +assignActivity()\n        +removeActivity()\n        +getAssignedActivities()\n        +isAvailable()\n        +hasCertification()\n        +getAssignedActivityTitles()\n        +getCertifications()\n        +displayInfo()\n        +sendNotification()\n    }\n\n    class AdminStaff {\n        -String role\n        +displayInfo()\n        +sendNotification()\n    }\n}\n\nnamespace management {\n    class Camp {\n        -String campId\n        -String campName\n        -LocalDate startDate\n        -LocalDate endDate\n        -int capacity\n        -String status\n        -CampSchedule schedule\n        -Repository registrations\n        -Repository safetyChecks\n        -Repository feedbacks\n        -Attendance attendance\n        -Repository participants\n        -Repository instructors\n        -Repository activities\n        -Repository equipmentList\n        -Repository locations\n        +registerParticipant()\n        +scheduleActivity()\n        +allocateEquipment()\n        +addSafetyCheck()\n        +addFeedback()\n        +findParticipant()\n        +findInstructor()\n        +findActivity()\n        +findLocation()\n        +findEquipment()\n        +getAvailableEquipment()\n        +getAverageFeedbackRating()\n        +broadcastToInstructors()\n        +generateReport()\n    }\n\n    class CampSchedule {\n        -Repository entries\n        +addEntry()\n        +removeEntry()\n        +getActivitiesForDate()\n        +getEntriesForActivity()\n        +getEntriesSortedByTime()\n        +hasConflict()\n    }\n\n    class ScheduleEntry {\n        -String entryId\n        -LocalDate date\n        -LocalDateTime startTime\n        -LocalDateTime endTime\n        -Activity activity\n        +getEntryId()\n        +getActivity()\n        +getStartTime()\n        +getDate()\n    }\n\n    class Registration {\n        -String registrationId\n        -LocalDate registrationDate\n        -String status\n        -Participant participant\n        -Activity activity\n        +getRegistrationId()\n        +getActivity()\n        +getParticipant()\n        +getRegistrationDate()\n        +getStatus()\n    }\n\n    class Attendance {\n        -Repository records\n        +recordAttendance()\n        +getRecordsForActivity()\n        +getRecordsForParticipant()\n        +getPresentCount()\n        +getAbsentCount()\n    }\n\n    class AttendanceRecord {\n        -Participant participant\n        -Activity activity\n        -LocalDate date\n        -boolean isPresent\n        +getParticipant()\n        +getActivity()\n        +getDate()\n        +isPresent()\n    }\n\n    class EquipmentAllocation {\n        -String allocationId\n        -LocalDate allocationDate\n        -LocalDate returnDate\n        -String status\n        -Equipment equipment\n        -Activity activity\n        +returnEquipment()\n        +getAllocationId()\n        +getAllocationDate()\n        +getReturnDate()\n        +getStatus()\n        +getEquipment()\n        +getActivity()\n    }\n\n    class SafetyCheck {\n        -String checkId\n        -LocalDate checkDate\n        -boolean passed\n        -String remarks\n        -Equipment equipment\n        -Activity activity\n        +getCheckId()\n        +getCheckDate()\n        +isPassed()\n        +getRemarks()\n        +getEquipment()\n        +getActivity()\n    }\n\n    class Feedback {\n        -String feedbackId\n        -int rating\n        -String comments\n        -LocalDate submittedDate\n        -Participant participant\n        -Activity activity\n        +getFeedbackId()\n        +getRating()\n        +getComments()\n        +getParticipant()\n        +getActivity()\n        +getSubmittedDate()\n    }\n\n    class Location {\n        -String locationId\n        -String name\n        -String address\n        -String terrainType\n        -int capacity\n        +getLocationId()\n        +getName()\n        +getAddress()\n        +getTerrainType()\n        +getCapacity()\n        +displayDetails()\n    }\n\n    class DataManager {\n        +DEFAULT_DB_PATH\n        +loadCamp()\n        +saveCamp()\n        -loadCampMetadata()\n        -loadLocations()\n        -loadParticipants()\n        -loadInstructors()\n        -loadEquipment()\n        -loadActivities()\n        -loadSchedules()\n        -loadRegistrations()\n        -loadAttendance()\n        -loadFeedbacks()\n    }\n\n    class Repository {\n        -List items\n        +add()\n        +remove()\n        +get()\n        +getAll()\n        +size()\n        +findFirst()\n        +filter()\n        +forEach()\n        +removeIf()\n        +map()\n        +sort()\n        +anyMatch()\n        +allMatch()\n        +count()\n    }\n\n    class Notifiable {\n        &lt;&lt;interface&gt;&gt;\n        +sendNotification()\n    }\n\n    class Schedulable {\n        &lt;&lt;interface&gt;&gt;\n        +updateSchedule()\n        +getStartTime()\n        +getEndTime()\n    }\n}\n\nnamespace equipment {\n    class Equipment {\n        &lt;&lt;abstract&gt;&gt;\n        -String equipmentId\n        -String name\n        -boolean isAvailable\n        -String condition\n        +getEquipmentId()\n        +getName()\n        +isAvailable()\n        +setAvailable()\n        +getCondition()\n        +setCondition()\n        +checkCondition()*\n    }\n\n    class SafetyEquipment {\n        -LocalDate lastInspectionDate\n        -String safetyRating\n        +checkCondition()\n        +getLastInspectionDate()\n        +getSafetyRating()\n    }\n\n    class SportsEquipment {\n        -String sportType\n        +checkCondition()\n        +getSportType()\n    }\n}\n\nnamespace activities {\n    class Activity {\n        &lt;&lt;abstract&gt;&gt;\n        -String activityId\n        -String title\n        -String description\n        -int durationMinutes\n        -int maxParticipants\n        -LocalDateTime startTime\n        -Location location\n        -Instructor instructor\n        -List participants\n        -List feedbackList\n        -List equipmentAllocations\n        +getActivityId()\n        +getTitle()\n        +getDescription()\n        +getDurationMinutes()\n        +getMaxParticipants()\n        +getLocation()\n        +getInstructor()\n        +getParticipants()\n        +addParticipant()\n        +removeParticipant()\n        +addFeedback()\n        +addEquipmentAllocation()\n        +getAverageRating()\n        +hasParticipant()\n        +getActiveAllocations()\n        +getStartTime()\n        +getEndTime()\n        +updateSchedule()\n        +conductActivity()*\n    }\n\n    class AdventureActivity {\n        -String terrainType\n        -String riskLevel\n        +conductActivity()\n        +getTerrainType()\n        +getRiskLevel()\n    }\n\n    class TeamBuildingActivity {\n        -int teamSize\n        +conductActivity()\n        +getTeamSize()\n    }\n\n    class WaterActivity {\n        -boolean lifeguardRequired\n        -String waterBodyType\n        +conductActivity()\n        +isLifeguardRequired()\n        +getWaterBodyType()\n    }\n}\n\nnamespace exceptions {\n    class CampException {\n        +CampException(message)\n    }\n\n    class CapacityExceededException {\n        +CapacityExceededException(message)\n    }\n\n    class EquipmentUnavailableException {\n        +EquipmentUnavailableException(message)\n    }\n\n    class RegistrationException {\n        +RegistrationException(message)\n    }\n\n    class SafetyViolationException {\n        +SafetyViolationException(message)\n    }\n}\n\nPerson &lt;|-- Participant\nPerson &lt;|-- Instructor\nPerson &lt;|-- AdminStaff\n\nNotifiable &lt;|.. Instructor\nNotifiable &lt;|.. AdminStaff\n\nEquipment &lt;|-- SafetyEquipment\nEquipment &lt;|-- SportsEquipment\n\nActivity &lt;|-- AdventureActivity\nActivity &lt;|-- TeamBuildingActivity\nActivity &lt;|-- WaterActivity\nSchedulable &lt;|.. Activity\n\nCampException &lt;|-- CapacityExceededException\nCampException &lt;|-- EquipmentUnavailableException\nCampException &lt;|-- RegistrationException\nCampException &lt;|-- SafetyViolationException\n\nCamp --&gt; CampSchedule\nCamp --&gt; Attendance\nCamp --&gt; Repository\nCampSchedule --&gt; ScheduleEntry\nScheduleEntry --&gt; Activity\nParticipant --&gt; Registration\nRegistration --&gt; Activity\nInstructor --&gt; Activity\nEquipmentAllocation --&gt; Equipment\nEquipmentAllocation --&gt; Activity\nSafetyCheck --&gt; Equipment\nSafetyCheck --&gt; Activity\nFeedback --&gt; Participant\nFeedback --&gt; Activity\nAttendance --&gt; AttendanceRecord\nAttendanceRecord --&gt; Participant\nAttendanceRecord --&gt; Activity\nActivity --&gt; Location\nActivity --&gt; Instructor\nActivity --&gt; EquipmentAllocation\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="RtoFqfchVlonFjVe_aLy-465">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
