  <diagram id="QQUxD9gn3pYx4IfmuXKR" name="FINAL-1">
    <mxGraphModel dx="4478" dy="2817" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n---\nconfig:\n  theme: base\n  themeVariables:\n    background: \&quot;#FFFFFF\&quot;\n    primaryColor: \&quot;#FFFFFF\&quot;\n    primaryTextColor: \&quot;#000000\&quot;\n    primaryBorderColor: \&quot;#000000\&quot;\n    lineColor: \&quot;#000000\&quot;\n    secondaryColor: \&quot;#FFFFFF\&quot;\n    tertiaryColor: \&quot;#FFFFFF\&quot;\n  layout: elk\n  elk:\n  mergeEdges: false\n  edgeRouting: ORTHOGONAL\n  nodePlacementStrategy: NETWORK_SIMPLEX\n  cycleBreakingStrategy: GREEDY\n---\nclassDiagram\ndirection TB\n\nclassDef default fill:#FFFFFF,stroke:#000000,color:#000000,stroke-width:1px\n\nnamespace people {\n    class Person {\n        &lt;&lt;abstract&gt;&gt;\n        -String id\n        -String name\n        -int age\n        -String contactNumber\n        +getId() String\n        +getName() String\n        +getAge() int\n        +getContactNumber() String\n        +setContactNumber(String) void\n        +displayInfo() void\n    }\n\n    class Participant {\n        -String emergencyContact\n        -String medicalNotes\n        -String skillLevel\n        -List~Registration~ registrations\n        +getRegistrations() List\n        +addRegistration(Registration) void\n        +removeRegistration(Registration) void\n        +isRegisteredFor(Activity) boolean\n        +getRegisteredActivities() List\n        +displayInfo() void\n    }\n\n    class Instructor {\n        -String specialization\n        -List~String~ certifications\n        -boolean isAvailable\n        -List~Activity~ assignedActivities\n        +getSpecialization() String\n        +assignActivity(Activity) void\n        +removeActivity(Activity) void\n        +getAssignedActivities() List\n        +isAvailable() boolean\n        +hasCertification(String) boolean\n        +getAssignedActivityTitles() List\n        +displayInfo() void\n        +sendNotification(String) void\n    }\n\n    class AdminStaff {\n        -String role\n        +displayInfo() void\n        +sendNotification(String) void\n    }\n}\n\nnamespace activities {\n    class Activity {\n        &lt;&lt;abstract&gt;&gt;\n        -String activityId\n        -String title\n        -String description\n        -int durationMinutes\n        -int maxParticipants\n        -LocalDateTime startTime\n        -Location location\n        -Instructor instructor\n        -List~Participant~ participants\n        -List~Feedback~ feedbackList\n        -List~EquipmentAllocation~ equipmentAllocations\n        +getActivityId() String\n        +getTitle() String\n        +getDescription() String\n        +getDurationMinutes() int\n        +getMaxParticipants() int\n        +getLocation() Location\n        +getInstructor() Instructor\n        +getParticipants() List\n        +getFeedbackList() List\n        +getEquipmentAllocations() List\n        +addParticipant(Participant) void\n        +removeParticipant(Participant) void\n        +addFeedback(Feedback) void\n        +addEquipmentAllocation(EquipmentAllocation) void\n        +getAverageRating() double\n        +hasParticipant(String) boolean\n        +getActiveAllocations() List\n        +getStartTime() LocalDateTime\n        +getEndTime() LocalDateTime\n        +updateSchedule(LocalDateTime) void\n        +conductActivity() void\n    }\n\n    class AdventureActivity {\n        -String terrainType\n        -String riskLevel\n        +conductActivity() void\n        +getTerrainType() String\n        +getRiskLevel() String\n    }\n\n    class TeamBuildingActivity {\n        -int teamSize\n        +conductActivity() void\n        +getTeamSize() int\n    }\n\n    class WaterActivity {\n        -boolean lifeguardRequired\n        -String waterBodyType\n        +conductActivity() void\n        +isLifeguardRequired() boolean\n        +getWaterBodyType() String\n    }\n}\n\nnamespace equipment {\n    class Equipment {\n        &lt;&lt;abstract&gt;&gt;\n        -String equipmentId\n        -String name\n        -boolean isAvailable\n        -String condition\n        +getEquipmentId() String\n        +getName() String\n        +isAvailable() boolean\n        +setAvailable(boolean) void\n        +getCondition() String\n        +setCondition(String) void\n        +checkCondition() void\n    }\n\n    class SafetyEquipment {\n        -LocalDate lastInspectionDate\n        -String safetyRating\n        +checkCondition() void\n        +getLastInspectionDate() LocalDate\n        +getSafetyRating() String\n    }\n\n    class SportsEquipment {\n        -String sportType\n        +checkCondition() void\n        +getSportType() String\n    }\n}\n\nnamespace management {\n    class Camp {\n        -String campId\n        -String campName\n        -LocalDate startDate\n        -LocalDate endDate\n        -int capacity\n        -String status\n        -CampSchedule schedule\n        -Repository~Registration~ registrations\n        -Repository~SafetyCheck~ safetyChecks\n        -Repository~Feedback~ feedbacks\n        -Attendance attendance\n        -Repository~Participant~ participants\n        -Repository~Instructor~ instructors\n        -Repository~Activity~ activities\n        -Repository~Equipment~ equipmentList\n        -Repository~Location~ locations\n        +registerParticipant(Participant, Activity) void\n        +scheduleActivity(Activity, LocalDateTime) void\n        +allocateEquipment(Equipment, Activity) void\n        +addSafetyCheck(SafetyCheck) void\n        +addFeedback(Feedback) void\n        +findParticipant(String) Optional\n        +findInstructor(String) Optional\n        +findActivity(String) Optional\n        +findLocation(String) Optional\n        +findEquipment(String) Optional\n        +getAvailableEquipment() List\n        +getPassedSafetyChecks() List\n        +getFailedSafetyChecks() List\n        +getRegistrationsForParticipant(String) List\n        +getRegistrationsForActivity(String) List\n        +getAverageFeedbackRating() double\n        +notifyStaff(String, Notifiable) void\n        +broadcastToInstructors(String) void\n        +generateReport() void\n    }\n\n    class Location {\n        -String locationId\n        -String name\n        -String address\n        -String terrainType\n        -int capacity\n        +getLocationId() String\n        +getName() String\n        +getCapacity() int\n        +getAddress() String\n        +getTerrainType() String\n        +displayDetails() void\n    }\n\n    class Registration {\n        -String registrationId\n        -LocalDate registrationDate\n        -String status\n        -Participant participant\n        -Activity activity\n        +getRegistrationId() String\n        +getActivity() Activity\n        +getParticipant() Participant\n        +getRegistrationDate() LocalDate\n        +getStatus() String\n        +displayInfo() void\n    }\n\n    class CampSchedule {\n        -Repository~ScheduleEntry~ entries\n        +addEntry(ScheduleEntry) void\n        +removeEntry(ScheduleEntry) void\n        +getActivitiesForDate(LocalDate) List\n        +getEntriesForActivity(Activity) List\n        +getEntriesSortedByTime() List\n        +hasConflict(LocalDateTime, LocalDateTime) boolean\n        +getEntries() Repository\n    }\n\n    class ScheduleEntry {\n        -String entryId\n        -LocalDate date\n        -LocalDateTime startTime\n        -LocalDateTime endTime\n        -Activity activity\n        +getEntryId() String\n        +getActivity() Activity\n        +getStartTime() LocalDateTime\n        +getDate() LocalDate\n    }\n\n    class EquipmentAllocation {\n        -String allocationId\n        -LocalDate allocationDate\n        -LocalDate returnDate\n        -String status\n        -Equipment equipment\n        -Activity activity\n        +returnEquipment() void\n        +getAllocationId() String\n        +getAllocationDate() LocalDate\n        +getReturnDate() LocalDate\n        +getStatus() String\n        +getEquipment() Equipment\n        +getActivity() Activity\n    }\n\n    class Feedback {\n        -String feedbackId\n        -int rating\n        -String comments\n        -LocalDate submittedDate\n        -Participant participant\n        -Activity activity\n        +getFeedbackId() String\n        +getRating() int\n        +getComments() String\n        +getParticipant() Participant\n        +getActivity() Activity\n        +getSubmittedDate() LocalDate\n    }\n\n    class SafetyCheck {\n        -String checkId\n        -LocalDate checkDate\n        -boolean passed\n        -String remarks\n        -Equipment equipment\n        -Activity activity\n        +getCheckId() String\n        +getCheckDate() LocalDate\n        +isPassed() boolean\n        +getRemarks() String\n        +getEquipment() Equipment\n        +getActivity() Activity\n    }\n\n    class Attendance {\n        -Repository~AttendanceRecord~ records\n        +recordAttendance(AttendanceRecord) void\n        +getRecordsForActivity(Activity) List\n        +getRecordsForParticipant(Participant) List\n        +getPresentCount(Activity) long\n        +getAbsentCount(Activity) long\n        +getRecords() Repository\n    }\n\n    class AttendanceRecord {\n        -Participant participant\n        -Activity activity\n        -LocalDate date\n        -boolean isPresent\n        +getParticipant() Participant\n        +getActivity() Activity\n        +getDate() LocalDate\n        +isPresent() boolean\n    }\n\n    class Repository~T~ {\n        -List~T~ items\n        +add(T) void\n        +remove(T) void\n        +get(int) T\n        +getAll() List\n        +size() int\n        +findFirst(Predicate) Optional\n        +filter(Predicate) List\n        +forEach(Consumer) void\n        +removeIf(Predicate) boolean\n        +map(Function) List\n        +sort(Comparator) void\n        +anyMatch(Predicate) boolean\n        +allMatch(Predicate) boolean\n        +count(Predicate) long\n    }\n\n    class DataManager {\n        +loadCamp(String)$ Camp\n        +saveCamp(Camp, String)$ void\n    }\n\n    class Notifiable {\n        &lt;&lt;interface&gt;&gt;\n        +sendNotification(String) void\n    }\n\n    class Schedulable {\n        &lt;&lt;interface&gt;&gt;\n        +getStartTime() LocalDateTime\n        +getEndTime() LocalDateTime\n        +updateSchedule(LocalDateTime) void\n    }\n}\n\nnamespace exceptions {\n    class CampException {\n        &lt;&lt;exception&gt;&gt;\n    }\n\n    class CapacityExceededException {\n        &lt;&lt;exception&gt;&gt;\n    }\n\n    class EquipmentUnavailableException {\n        &lt;&lt;exception&gt;&gt;\n    }\n\n    class RegistrationException {\n        &lt;&lt;exception&gt;&gt;\n    }\n\n    class SafetyViolationException {\n        &lt;&lt;exception&gt;&gt;\n    }\n}\n\n%% Inheritance\nPerson &lt;|-- Participant\nPerson &lt;|-- Instructor\nPerson &lt;|-- AdminStaff\n\nActivity &lt;|-- AdventureActivity\nActivity &lt;|-- TeamBuildingActivity\nActivity &lt;|-- WaterActivity\n\nEquipment &lt;|-- SafetyEquipment\nEquipment &lt;|-- SportsEquipment\n\nCampException &lt;|-- CapacityExceededException\nCampException &lt;|-- EquipmentUnavailableException\nCampException &lt;|-- RegistrationException\nCampException &lt;|-- SafetyViolationException\n\n%% Interface implementation\nSchedulable &lt;|.. Activity\nNotifiable &lt;|.. Instructor\nNotifiable &lt;|.. AdminStaff\n\n%% Core management relationships\nCamp --&gt; CampSchedule\nCamp --&gt; Attendance\nCamp --&gt; Activity\nCamp --&gt; Equipment\n\n%% Registration and scheduling\nParticipant --&gt; Registration\nRegistration --&gt; Activity\nCampSchedule --&gt; ScheduleEntry\nScheduleEntry --&gt; Activity\n\n%% Activity relationships\nActivity --&gt; Location\nActivity --&gt; Instructor\nActivity --&gt; EquipmentAllocation\nActivity --&gt; Feedback\n\n%% Equipment and safety\nEquipmentAllocation --&gt; Equipment\nSafetyCheck --&gt; Equipment\n\n%% Attendance and feedback\nAttendance --&gt; AttendanceRecord\nAttendanceRecord --&gt; Participant\nFeedback --&gt; Participant\n\n%% Persistence\nDataManager ..&gt; Camp\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="MSb_6J9f0lNT01W-Vxxa-1872">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
